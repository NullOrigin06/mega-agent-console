# Mega Agent Console API Configuration
# Toggle between 'mock' and 'real'
VITE_API_MODE=mock

# Base URL for the real API endpoint (mega-agent-api)
VITE_API_BASE_URL=http://localhost:5299/api/jobs

# Required once mega-agent-api is reachable beyond localhost (its API key
# middleware rejects every /api/* request without a matching X-Api-Key
# header). Must match the MEGA_API_KEY the API server was started with.
# Safe to leave unset for pure-localhost development.
VITE_API_KEY=
