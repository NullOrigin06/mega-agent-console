# Mega Agent Console API Configuration
# Toggle between 'mock' and 'real'
VITE_API_MODE=mock

# Base URL for the real API endpoint (mega-agent-api)
# In production, when served from mega-agent-api's wwwroot, use relative '/api/jobs'
VITE_API_BASE_URL=http://localhost:5299/api/jobs

# Authentication:
# Per-user accounts (/api/auth/login and /api/auth/signup) now provide dynamic
# API keys stored in the browser session (localStorage).
# VITE_API_KEY is DEPRECATED and only kept as a fallback for automated test runners.
VITE_API_KEY=

